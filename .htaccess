<IfModule mod_rewrite.c>
    RewriteEngine On
    # RewriteBase kasıtlı olarak belirtilmiyor — Apache bunu otomatik olarak
    # .htaccess dosyasının bulunduğu klasöre göre hesaplar. Böylece sistem
    # kökte de, bir alt klasörde de (örn. /ahostone) doğru çalışır.

    # Hassas dosyaları web erişiminden koru
    RewriteRule ^(?:\.env|\.git|composer\.(?:json|lock)|phpunit\.xml|Dockerfile|README\.md|QUICKSTART\.md|console|config/|database/|storage/|tests/|docs/|planning/|k8s/)(?:/|$) - [F,L,NC]

    # Gerçek dosya ve klasörleri doğrudan sun
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Diğer tüm istekleri front controller'a aktar
    RewriteRule ^ index.php [QSA,L]
</IfModule>

Options -Indexes
DirectoryIndex index.php

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

<FilesMatch "^(\.env|composer\.(json|lock)|phpunit\.xml|Dockerfile|README.*|QUICKSTART.*|console)$">
    Require all denied
</FilesMatch>
