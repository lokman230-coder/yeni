{
    "name": "ahost/ahost-bilisim",
    "description": "Ahost Bilişim - Modern, modüler hosting/domain/dijital hizmet yönetim platformu",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": "^8.2",
        "ext-pdo": "*",
        "ext-mbstring": "*",
        "ext-json": "*",
        "ext-openssl": "*",
        "ext-fileinfo": "*",
        "ext-curl": "*",
        "phpmailer/phpmailer": "^6.9",
        "dompdf/dompdf": "^3.0",
        "pragmarx/google2fa": "^8.0",
        "bacon/bacon-qr-code": "^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        },
        "files": [
            "app/Support/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit --testdox",
        "migrate": "php console migrate",
        "migrate:fresh": "php console migrate:fresh",
        "seed": "php console seed",
        "serve": "php -S localhost:8000 -t public public/router.php"
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
