#!/usr/bin/env php
<?php
/**
 * Ahost Bilişim CLI
 * Kullanım:
 *   php console migrate
 *   php console migrate:fresh
 *   php console migrate:fresh --seed
 *   php console seed
 *   php console rollback [--steps=1]
 *   php console serve [--port=8000]
 */

declare(strict_types=1);

define('AHO_START', microtime(true));
define('AHO_ROOT', __DIR__);

require AHO_ROOT . '/app/Core/bootstrap.php';

use App\Core\Config;
use App\Core\Database\Migrator;
use App\Core\Env;
use App\Services\Logger\Logger;

Env::load(AHO_ROOT . '/.env');
Config::load(AHO_ROOT . '/config');
Logger::init(AHO_ROOT . '/storage/logs');

$args = $argv;
array_shift($args);
$command = $args[0] ?? 'help';

function out(string $msg, string $color = 'default'): void
{
    $colors = [
        'default' => "\033[0m",
        'red'     => "\033[31m",
        'green'   => "\033[32m",
        'yellow'  => "\033[33m",
        'blue'    => "\033[34m",
        'cyan'    => "\033[36m",
        'gray'    => "\033[90m",
    ];
    echo ($colors[$color] ?? '') . $msg . $colors['default'] . PHP_EOL;
}

function runSeeders(): void
{
    $dir = AHO_ROOT . '/database/seeds';
    if (!is_dir($dir)) return;
    foreach (glob($dir . '/*.php') as $file) {
        $seeder = require $file;
        if (is_object($seeder) && method_exists($seeder, 'run')) {
            out('  ▸ ' . basename($file), 'gray');
            $seeder->run();
        }
    }
}

try {
    switch ($command) {
        case 'migrate':
            out('▸ Migration çalıştırılıyor...', 'cyan');
            $m = new Migrator(AHO_ROOT);
            $executed = $m->run();
            if (empty($executed)) {
                out('  Beklemede migration yok.', 'gray');
            } else {
                foreach ($executed as $name) out('  ✓ ' . $name, 'green');
            }
            break;

        case 'migrate:fresh':
            $suffix = in_array('--seed', $args, true) ? ' + seed' : '';
            out('▸ Tüm tablolar siliniyor ve migration' . $suffix . ' baştan çalıştırılıyor...', 'yellow');
            $m = new Migrator(AHO_ROOT);
            $executed = $m->fresh();
            foreach ($executed as $name) out('  ✓ ' . $name, 'green');
            if (in_array('--seed', $args)) {
                out('▸ Seeder çalıştırılıyor...', 'cyan');
                runSeeders();
            }
            out('✓ Tamamlandı.', 'green');
            break;

        case 'seed':
            out('▸ Seeder çalıştırılıyor...', 'cyan');
            runSeeders();
            out('✓ Tamamlandı.', 'green');
            break;

        case 'rollback':
            $steps = 1;
            foreach ($args as $a) {
                if (str_starts_with($a, '--steps=')) $steps = (int) substr($a, 8);
            }
            $m = new Migrator(AHO_ROOT);
            $rolled = $m->rollback($steps);
            foreach ($rolled as $name) out('  ↩ ' . $name, 'yellow');
            out('✓ Rollback tamamlandı.', 'green');
            break;

        case 'serve':
            $port = 8000;
            foreach ($args as $a) {
                if (str_starts_with($a, '--port=')) $port = (int) substr($a, 7);
            }
            out("▸ Ahost Bilişim geliştirme sunucusu http://localhost:{$port}", 'cyan');
            passthru("php -S localhost:{$port} -t public");
            break;

        case 'routes':
            require AHO_ROOT . '/app/Core/bootstrap.php';
            $app = \App\Core\Application::boot(AHO_ROOT);
            $routes = $app->router()->getRoutes();
            out(sprintf('%-8s %-50s %s', 'METHOD', 'PATH', 'NAME'), 'cyan');
            out(str_repeat('─', 80), 'gray');
            foreach ($routes as $r) {
                out(sprintf('%-8s %-50s %s', $r['method'], $r['path'], $r['name'] ?? ''));
            }
            break;

        case 'key:generate':
            $key = \App\Support\Encrypter::generateKey();
            $envPath = AHO_ROOT . '/.env';
            if (file_exists($envPath)) {
                $env = file_get_contents($envPath);
                if (preg_match('/^APP_KEY=.*/m', $env)) {
                    $env = preg_replace('/^APP_KEY=.*/m', "APP_KEY={$key}", $env);
                } else {
                    $env = rtrim($env) . "\nAPP_KEY={$key}\n";
                }
                file_put_contents($envPath, $env);
                out('✓ APP_KEY oluşturuldu ve .env dosyasına yazıldı.', 'green');
                out("  {$key}", 'gray');
            } else {
                out('.env dosyası yok. Önce cp .env.example .env yapın.', 'red');
                exit(1);
            }
            break;

        case 'cron:run':
            \App\Console\CronCommands::registerAll();
            $r = \App\Services\Cron\CronScheduler::run();
            out("✓ Cron çalıştı — " . $r['ran'] . " görev.", 'green');
            break;

        case 'cron:install':
            \App\Console\CronCommands::registerAll();
            \App\Services\Cron\CronScheduler::schedule('mail:queue',              'Mail kuyruğunu işle',           '* * * * *');
            \App\Services\Cron\CronScheduler::schedule('domains:renewal-reminder','Domain yenileme hatırlatma',    '0 0 * * *');
            \App\Services\Cron\CronScheduler::schedule('services:due-check',      'Vadesi geçen hizmet kontrolü',  '0 0 * * *');
            \App\Services\Cron\CronScheduler::schedule('currency:update',         'Kur güncelleme',                '0 * * * *');
            \App\Services\Cron\CronScheduler::schedule('cache:clean',             'Cache temizleme',               '0 0 * * *');
            \App\Services\Cron\CronScheduler::schedule('ratelimit:clean',         'Rate limit dosyalarını temizle','0 * * * *');
            \App\Services\Cron\CronScheduler::schedule('logs:cleanup',            'Eski logları temizle',          '0 0 * * *');
            \App\Services\Cron\CronScheduler::schedule('cron:log-cleanup',        'Eski cron loglarını temizle',   '0 0 * * *');
            \App\Services\Cron\CronScheduler::schedule('hosting:usage-update',    'Hosting kullanım senkron',      '0 */6 * * *');
            \App\Services\Cron\CronScheduler::schedule('auth:token-cleanup',      'Auth token temizliği',          '0 3 * * *');
            out('✓ 10 cron görevi kayıtlı.', 'green');
            out('  Sunucuya şu satırı ekleyin:', 'gray');
            out('  * * * * * cd ' . AHO_ROOT . ' && php console cron:run > /dev/null 2>&1', 'cyan');
            break;

        case 'mail:test':
            $to = $args[1] ?? '';
            if ($to === '') { out('Kullanım: php console mail:test <alici@example.com>', 'red'); exit(1); }
            $res = \App\Services\Mail\Mailer::sendRaw($to, 'Ahost Bilişim Test', '<h1>Merhaba!</h1><p>Bu bir test mailidir.</p>', 'Test', 'Merhaba, test.', true);
            if ($res['ok']) out('✓ Mail gönderildi', 'green');
            else out('✗ Hata: ' . ($res['error'] ?? '?'), 'red');
            break;

        case 'mail:queue':
            $r = \App\Services\Mail\Mailer::processQueue(50);
            out("Mail queue: {$r['sent']} gönderildi, {$r['failed']} başarısız.", 'cyan');
            break;

        case 'health:full-check':
        case 'health:check':
            out('🩺 Ahost Bilişim — Sağlık Kontrolü', 'cyan');
            out('');
            $failed = 0;
            $checks = [
                'PHP Versiyon (>= 8.2)'        => fn() => PHP_VERSION_ID >= 80200 ? ['ok', PHP_VERSION] : ['fail', 'Mevcut: ' . PHP_VERSION],
                'PDO MySQL extension'          => fn() => extension_loaded('pdo_mysql') ? ['ok', 'yüklü'] : ['fail', 'eksik'],
                'cURL extension'               => fn() => extension_loaded('curl')      ? ['ok', 'yüklü'] : ['fail', 'eksik'],
                'GD extension'                 => fn() => extension_loaded('gd')        ? ['ok', 'yüklü'] : ['fail', 'eksik'],
                'ZIP extension'                => fn() => extension_loaded('zip')       ? ['ok', 'yüklü'] : ['fail', 'eksik'],
                'OpenSSL extension'            => fn() => extension_loaded('openssl')   ? ['ok', 'yüklü'] : ['fail', 'eksik'],
                'storage/ yazılabilir'         => fn() => is_writable(AHO_ROOT . '/storage')  ? ['ok', ''] : ['fail', 'chmod 775 önerilir'],
                '.env dosyası'                 => fn() => is_file(AHO_ROOT . '/.env')         ? ['ok', ''] : ['fail', 'dosya yok'],
                'APP_KEY tanımlı'              => fn() => (string) env('APP_KEY', '') !== ''  ? ['ok', ''] : ['fail', 'php console key:generate çalıştırın'],
                'installed.lock'               => fn() => is_file(AHO_ROOT . '/storage/installed.lock') ? ['ok', 'kurulum tamamlandı'] : ['warn', 'kurulum yapılmamış → install.php aç'],
                'Veritabanı bağlantısı'        => function () {
                    try { \App\Core\Database\Connection::pdo()->query('SELECT 1'); return ['ok', 'bağlı']; }
                    catch (\Throwable $e) { return ['fail', $e->getMessage()]; }
                },
                'Migration durumu'             => function () {
                    try {
                        $c = \App\Core\Database\Connection::selectOne("SELECT COUNT(*) c FROM migrations");
                        return ['ok', (int)($c['c']??0) . ' migration çalıştı'];
                    } catch (\Throwable $e) { return ['fail', 'migrations tablosu yok'];
                }},
                'Admin hesabı'                 => function () {
                    try {
                        $c = \App\Core\Database\Connection::selectOne("SELECT COUNT(*) c FROM admins WHERE is_active = 1");
                        return (int)($c['c']??0) > 0 ? ['ok', $c['c'] . ' aktif admin'] : ['warn', 'aktif admin yok'];
                    } catch (\Throwable) { return ['fail', 'admins tablosu yok']; }
                },
                'SMTP ayarları'                => function () {
                    $host = \App\Services\Settings\SettingsManager::get('mail.host', '', 'MAIL_HOST');
                    return $host !== '' ? ['ok', 'ayarlı'] : ['warn', 'ayarlanmamış — mail gönderilmeyecek'];
                },
                'Ödeme sağlayıcı'              => function () {
                    foreach (['paytr.merchant_id', 'iyzico.api_key', 'papara.api_key', 'shopier.api_key'] as $k) {
                        if ((string) \App\Services\Settings\SettingsManager::get($k, '') !== '') return ['ok', 'en az bir sağlayıcı yapılandırılmış'];
                    }
                    return ['warn', 'hiç ödeme sağlayıcı yok — sadece havale/bakiye çalışır'];
                },
                'Currency güncel mi'           => function () {
                    try {
                        $c = \App\Core\Database\Connection::selectOne(
                            "SELECT COUNT(*) c FROM currency_rates WHERE source='tcmb' AND updated_at > DATE_SUB(NOW(), INTERVAL 24 HOUR)"
                        );
                        return (int)($c['c']??0) > 0 ? ['ok', 'son 24 saatte güncellendi'] : ['warn', 'kur güncel değil — cron:run çalıştırın'];
                    } catch (\Throwable) { return ['warn', 'currency_rates tablosu boş']; }
                },
                'Cron log kaydı'               => function () {
                    try {
                        $c = \App\Core\Database\Connection::selectOne("SELECT COUNT(*) c FROM cron_logs WHERE created_at > DATE_SUB(NOW(), INTERVAL 1 HOUR)");
                        return (int)($c['c']??0) > 0 ? ['ok', 'son saatte cron çalıştı'] : ['warn', 'cron çalışmıyor olabilir'];
                    } catch (\Throwable) { return ['warn', 'cron_logs yok']; }
                },
                'Disk boş alan'                => function () {
                    $free = @disk_free_space(AHO_ROOT);
                    if ($free === false) return ['warn', 'ölçülemedi'];
                    $gb = $free / 1073741824;
                    return $gb > 1 ? ['ok', round($gb, 2) . ' GB'] : ['fail', 'sadece ' . round($gb, 2) . ' GB — kritik!'];
                },
            ];

            $labelW = 32;
            foreach ($checks as $label => $fn) {
                try { [$state, $detail] = $fn(); } catch (\Throwable $e) { $state = 'fail'; $detail = $e->getMessage(); }
                $icon = ['ok'=>'✓', 'warn'=>'!', 'fail'=>'✗'][$state] ?? '?';
                $color = ['ok'=>'green','warn'=>'yellow','fail'=>'red'][$state] ?? 'gray';
                if ($state === 'fail') $failed++;
                out(sprintf('  [%s] %s %s', $icon, str_pad($label, $labelW), $detail ? '— ' . $detail : ''), $color);
            }
            out('');
            if ($failed === 0) out('✓ Tüm kritik kontroller geçti. Sistem sağlıklı.', 'green');
            else               out("✗ $failed kritik kontrol başarısız. Yukarıdaki hataları giderin.", 'red');
            exit($failed === 0 ? 0 : 1);

        case 'maintenance:on':
            @file_put_contents(AHO_ROOT . '/storage/maintenance.lock', json_encode([
                'enabled_at' => date('c'),
                'message'    => $args[1] ?? 'Sistem bakımda. Kısa süre içinde döneceğiz.',
            ]));
            out('🔧 Bakım modu AÇILDI. Public site ziyaretçilere bakım ekranı gösterecek.', 'yellow');
            out('   Admin paneli açık kalır.', 'gray');
            break;

        case 'maintenance:off':
            @unlink(AHO_ROOT . '/storage/maintenance.lock');
            out('✓ Bakım modu KAPATILDI. Site erişilebilir.', 'green');
            break;

        case 'backup:s3-sync':
            if (!(bool)\App\Services\Settings\SettingsManager::get('backup.s3_enabled', '0')) {
                out('⚠ Off-site backup kapalı — Ayarlar > Backup / S3\'ten aç.', 'yellow');
                break;
            }
            out('☁ S3 sync başlıyor...', 'cyan');
            $r = \App\Services\Backup\S3Uploader::syncBackupDir();
            if (!empty($r['ok'])) {
                out("✓ {$r['sent']} yedek gönderildi, {$r['failed']} başarısız.", 'green');
                foreach ($r['errors'] ?? [] as $e) out("  ✗ $e", 'red');
            } else {
                out('✗ Sync başarısız: ' . ($r['error'] ?? '?'), 'red');
            }
            break;

        case 'billing:auto-charge':
            out('💳 Otomatik tahsilat cron başlıyor...', 'cyan');
            $r = \App\Services\Billing\RecurringChargeService::run(3);
            out("✓ Toplam: {$r['total']} — Başarılı: {$r['success']}, Başarısız: {$r['failed']}, Atlanan: {$r['skipped']}", 'green');
            break;

        case 'domain:sync-tld-prices':
            out('🌐 Registrar\'dan TLD fiyatları çekiliyor...', 'cyan');
            $registrar = \App\Modules\Registrar\RegistrarManager::default();
            if (!method_exists($registrar, 'tldPrices')) {
                out('✗ Aktif registrar TLD fiyat çekmeyi desteklemiyor.', 'red');
                break;
            }
            $prices = $registrar->tldPrices();
            if (empty($prices)) {
                out('⚠ Fiyat gelmedi. reseller_id + api_key doğru mu?', 'yellow');
                break;
            }
            $regId = \App\Core\Database\Connection::selectOne(
                "SELECT id FROM domain_registrars WHERE is_default = 1 LIMIT 1"
            )['id'] ?? null;
            $updated = 0;
            foreach ($prices as $tld => $p) {
                $exists = \App\Core\Database\Connection::selectOne(
                    "SELECT id FROM domain_pricing WHERE tld = ? AND period_years = 1", [$tld]
                );
                $data = [
                    'registrar_id'   => $regId,
                    'tld'            => $tld,
                    'period_years'   => 1,
                    'register_price' => $p['register'],
                    'transfer_price' => $p['transfer'],
                    'renew_price'    => $p['renew'],
                    'currency'       => $p['currency'],
                    'is_active'      => 1,
                    'updated_at'     => date('Y-m-d H:i:s'),
                ];
                if ($exists) {
                    \App\Core\Database\Connection::update('domain_pricing', $data, 'id = ?', [$exists['id']]);
                } else {
                    $data['created_at'] = date('Y-m-d H:i:s');
                    \App\Core\Database\Connection::insert('domain_pricing', $data);
                }
                $updated++;
            }
            out("✓ $updated TLD fiyatı güncellendi (satış fiyatı = maliyet + tld_configs.markup).", 'green');
            break;

        case 'builder:build-mobile':
            out('📱 Mobile build queue çalışıyor...', 'cyan');
            $jobs = \App\Core\Database\Connection::select(
                "SELECT id FROM builder_export_jobs WHERE status = 'pending' AND export_type IN ('mobile_apk','mobile_aab','flutter_source','react_native_source','android_source','site_zip') LIMIT 20"
            );
            $done = 0; $failed = 0;
            foreach ($jobs as $j) {
                $r = \App\Modules\Builder\Services\MobileExportService::processJob((int)$j['id']);
                if (!empty($r['ok'])) $done++; else $failed++;
            }
            out("✓ $done tamamlandı, $failed başarısız.", 'green');
            break;

        case 'help':
        default:
            out('Ahost Bilişim CLI', 'cyan');
            out('');
            out('Komutlar:');
            out('  migrate               Bekleyen migration\'ları çalıştır');
            out('  migrate:fresh         Tüm tabloları silip baştan kur');
            out('  migrate:fresh --seed  Fresh + seed');
            out('  seed                  Seed dosyalarını çalıştır');
            out('  rollback [--steps=N]  Son N batch rollback');
            out('  routes                Tüm route\'ları listele');
            out('  serve [--port=8000]   Dahili PHP sunucusunu başlat');
            out('  health:check          18 madde sağlık kontrolü (deploy sonrası)');
            out('  maintenance:on [msg]  Bakım modunu aç (public site kapanır)');
            out('  maintenance:off       Bakım modunu kapat');
            out('  cron:run              Zamanı gelen cron\'ları çalıştır');
            out('  cron:install          Default 12 cron\'u kaydet');
            out('  mail:test <to>        Test maili gönder');
            out('  mail:queue            Mail kuyruğunu işle (cron)');
            out('  key:generate          Yeni APP_KEY üret');
            break;
    }
} catch (\Throwable $e) {
    out('HATA: ' . $e->getMessage(), 'red');
    out('  ' . $e->getFile() . ':' . $e->getLine(), 'gray');
    exit(1);
}
