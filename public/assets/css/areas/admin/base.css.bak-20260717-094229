body[data-app="admin"],body.ao-admin{background:#f7f9fc;color:#13233a;font-family:var(--ao-font)}.admin-layout{display:grid;grid-template-columns:315px minmax(0,1fr);min-height:100vh}.admin-main{padding:26px}.admin-page-title h1,.admin-main h1{font-weight:700}.admin-main h2,.admin-main h3{font-weight:660}.admin-content-card,.admin-section,.admin-box{border:1px solid var(--ao-line);border-radius:22px;background:#fff;box-shadow:var(--ao-shadow-sm);padding:22px}.admin-grid{display:grid;gap:18px}.admin-grid.cols-2{grid-template-columns:repeat(2,minmax(0,1fr))}.admin-grid.cols-3{grid-template-columns:repeat(3,minmax(0,1fr))}@media(max-width:1100px){.admin-layout{grid-template-columns:1fr}.admin-main{padding:18px}}