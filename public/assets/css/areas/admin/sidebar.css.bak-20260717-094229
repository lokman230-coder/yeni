.admin-sidebar{background:#0d2137;color:#dbeafe;border-right:1px solid rgba(255,255,255,.08);height:100vh;position:sticky;top:0;overflow:auto;padding:18px 14px}.admin-sidebar a{display:flex;align-items:center;gap:10px;min-height:46px;padding:11px 14px;border:1px solid rgba(255,255,255,.08);border-radius:13px;color:#dbeafe;font-weight:600}.admin-sidebar a:hover,.admin-sidebar a.active,.admin-sidebar .is-active>a{background:rgba(37,99,235,.78);color:#fff;border-color:rgba(255,255,255,.22)}.admin-sidebar .section-title{margin:22px 6px 9px;color:#9fc5ff;font-size:12px;font-weight:760;letter-spacing:.08em;text-transform:uppercase}.admin-sidebar .submenu{padding:8px 0 8px 20px}.admin-sidebar .submenu a{min-height:38px;background:rgba(255,255,255,.04);font-size:14px;font-weight:520}